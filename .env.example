# Copy this file to .env for local development.
# .env / .env.*.local are gitignored — never commit real values.

# Which environment this build targets: local | development | preview | production
# Defaults to "local" when unset and __DEV__ is true, "production" otherwise.
EXPO_PUBLIC_APP_ENV=local

# Required. Supabase project URL and anon (public) key.
# Use a non-production Supabase project for local/development work — see
# docs/backend/architecture.md#environments for why this matters.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Optional table name overrides. Accepts "table_name" or "schema.table_name".
EXPO_PUBLIC_TRANSACTIONS_TABLE=transactions
EXPO_PUBLIC_GOALS_TABLE=goals
