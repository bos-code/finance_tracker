# Local app connected to a local Supabase project.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=replace-with-local-anon-key
EXPO_PUBLIC_UI_PREVIEW=0

# Keep service-role keys, Telegram secrets, and AI provider keys server-only.
# They must be configured as Supabase Edge Function secrets, never EXPO_PUBLIC_*.
